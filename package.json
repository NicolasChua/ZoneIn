{
  "name": "mckays-app-template",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run start:dev",
    "start:dev": "dotenv -e config/env/.env.local -- next dev -p 8080",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "npm run lint:fix && npm run format:write",
    "types": "tsc --noEmit",
    "lint:fix": "next lint --fix",
    "format:write": "prettier --write \"src/**/*.{ts,tsx}\" --cache",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" --cache",
    "tsc": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run tsc && npm run test:ci",
    "db:push": "dotenv -e config/env/.env.local -- drizzle-kit push",
    "db:migrate": "dotenv -e config/env/.env.local -- drizzle-kit migrate",
    "db:seed": "dotenv -e config/env/.env.local -- bun src/db/seed/index.ts",
    "test": "dotenv -e config/env/.env.test -- vitest",
    "test:ci": "dotenv -e config/env/.env.test -- vitest run --coverage"
  },
