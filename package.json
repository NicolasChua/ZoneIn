{
  "name": "mckays-app-template",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "node src/app/index.js",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "npm run lint:fix && npm run format:write",
    "types": "tsc --noEmit",
    "lint:fix": "next lint --fix",
    "format:write": "prettier --write \"src/**/*.{ts,tsx}\" --cache",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" --cache",
   "analyze": "ANALYZE=true npm run build",
    "db:local": "npx supabase start",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "npx drizzle-kit migrate",
    "db:seed": "npx bun db/seed",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:zoning": "node src/app/scripts/test-zoning.mjs",
    "test:e2e": "playwright test"
  },
